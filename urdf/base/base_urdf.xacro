<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find lightrover_description)/urdf/base/base_gazebo.xacro"/>

  <!--
    base_link は車輪2個を除いた車体全体(シャーシ・モーター・バッテリー・基板・LiDAR)。
    実機総質量 0.516 kg から車輪 2 x 0.0135 kg とキャスター 0.005 kg を引いた値。
    ROS1版は Gazebo(ODE)での動作安定化のため 0.002 kg に、車輪は 2.0 kg にしていた。
  -->
  <xacro:property name="base_mass" value="0.484"/>

  <xacro:macro name="base" params="parent *joint_origin">
    <joint name="base_joint" type="fixed">
      <xacro:insert_block name="joint_origin"/>
      <parent link="${parent}"/>
      <child link="base_link"/>
    </joint>

    <link name="base_link">
      <visual>
        <geometry>
          <mesh filename="package://lightrover_description/meshes/base_link.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="-0.025 0.0 0.04" rpy="0.0 0.0 0.0"/>
        <geometry>
          <cylinder radius="0.075" length="0.08"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="-0.025 0.0 0.024" rpy="0.0 0.0 0.0"/>
        <mass value="${base_mass}"/>
        <inertia ixx="8.0206480e-4" ixy="3.2953465e-5" ixz="3.1434721e-5"
                 iyy="9.0126446e-4" iyz="-1.2433875e-4"
                 izz="6.4944281e-4"/>
      </inertial>
    </link>
  </xacro:macro>

</robot>
