    </model>
    <model name="wall_3">
      <static>true</static>
      <pose>0.367033 -3.43294 0.5 0 0 0</pose>
      <link name="link">
        <pose>0 0 0 0 0 0</pose>
        <collision name="collision_0">
          <pose>0 0 0 0 0 0</pose>
          <geometry><box><size>0.999999 1 1</size></box></geometry>
        </collision>
        <visual name="visual_0">
          <pose>0 0 0 0 0 0</pose>
          <geometry><box><size>0.999999 1 1</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="cylinder_0">
      <static>true</static>
      <pose>2.41806 2.99539 0.499999 0 0 0</pose>
      <link name="link">
        <pose>0 0 0 0 0 0</pose>
        <collision name="collision_0">
          <pose>0 0 0 0 0 0</pose>
          <geometry><cylinder><radius>0.5</radius><length>1</length></cylinder></geometry>
        </collision>
        <visual name="visual_0">
